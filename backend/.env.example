# Local-development template only. Production must use APP_ENV=production,
# APP_DEBUG=false, a stable private APP_KEY, and an HTTPS APP_URL.
# See ../docs/PRODUCTION_DEPLOYMENT.md before configuring a live environment.
APP_NAME=Marremove
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
# Comma-separated trusted proxy IPs/CIDRs; empty for direct/local connections.
TRUSTED_PROXIES=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=960

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Facebook Page connection uses this Graph API version.
# This backend does not consume the App ID (there is no Facebook Login/OAuth SDK flow).
# FACEBOOK_APP_ID=<Meta dashboard ID; metadata only, not a required runtime setting>
# Configure the App ID in Meta's Developer Dashboard when registering the webhook.
FACEBOOK_GRAPH_VERSION=v26.0
FACEBOOK_MAX_POSTS_PER_SYNC=50
FACEBOOK_MAX_COMMENTS_PER_POST=100
FACEBOOK_MAX_PAGES_PER_SYNC=100
FACEBOOK_APP_SECRET=
FACEBOOK_WEBHOOK_VERIFY_TOKEN=

# Comma-separated, server-side allowlist for moderation administration and Facebook actions.
MODERATION_ADMIN_EMAILS=
MODERATION_AUTO_REVIEW_THRESHOLD=0.70
MODERATION_AUTO_HIDE_THRESHOLD=0.90
MODERATION_AUTO_DELETE_THRESHOLD=0.98
MODERATION_ALLOW_AI_HIDE=true
MODERATION_ALLOW_AI_DELETE=false
MODERATION_AUTO_HIDE_ENABLED=true
MODERATION_AUTO_DELETE_ENABLED=false
MODERATION_AUTO_EXECUTE_ACTIONS=false
MODERATION_TEST_MODE=false
MODERATION_ACTION_QUEUE_CONNECTION=database
MODERATION_ACTION_MAX_ATTEMPTS=3
MODERATION_REGEX_BACKTRACK_LIMIT=10000
MODERATION_REGEX_RECURSION_LIMIT=1000
MODERATION_MAX_COMMENT_LENGTH=20000

# Gemini moderation is backend-only and disabled until explicitly enabled.
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT=20
GEMINI_MAX_RETRIES=3
GEMINI_QUEUE_CONNECTION=database
GEMINI_RETRY_BASE_DELAY_MS=250
GEMINI_MAX_COMMENT_CHARACTERS=20000
GEMINI_MAX_POST_CONTEXT_CHARACTERS=5000
