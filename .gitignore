# Local environment files. Commit only the example templates.
.env
.env.*
!.env.example

# Laravel backend
/backend/.env
/backend/.env.*
!/backend/.env.example
/backend/vendor/
/backend/public/build/
/backend/public/hot
/backend/storage/*.key
/backend/storage/logs/*.log
/backend/bootstrap/cache/*.php
/backend/.phpunit.cache/
/backend/.phpunit.result.cache

# React / Vite frontend
/frontend/.env
/frontend/.env.*
!/frontend/.env.example
/frontend/node_modules/
/frontend/dist/
/frontend/.vite/

# General
*.log
.DS_Store
Thumbs.db
